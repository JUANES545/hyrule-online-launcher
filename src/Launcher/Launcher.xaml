<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hyrule Online" Width="1280" Height="850" MinWidth="1" MinHeight="1" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 WindowStartupLocation="Manual" Background="#F00B1015" Foreground="#EAF2F2" FontFamily="{DynamicResource MenuFont}" FontStretch="Condensed" FontSize="18" TextOptions.TextRenderingMode="Grayscale">
 <Window.Resources>
  <FontFamily x:Key="MenuFont">Segoe UI</FontFamily>
  <FontFamily x:Key="TitleFont">Georgia</FontFamily>
  <FontFamily x:Key="LogoFont">Georgia</FontFamily>
  <GeometryGroup x:Key="PersonIcon"><EllipseGeometry Center="12,4" RadiusX="3" RadiusY="3"/><PathGeometry Figures="M 8,9 L 16,9 19,18 16,19 14,13 14,21 16,30 12,30 11,23 10,30 6,30 9,21 9,13 7,19 4,18 Z"/></GeometryGroup>
  <DrawingImage x:Key="P1Person"><DrawingImage.Drawing><GeometryDrawing Brush="#7EE9C9" Geometry="{StaticResource PersonIcon}"/></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="P2Person"><DrawingImage.Drawing><GeometryDrawing Brush="#E5C384" Geometry="{StaticResource PersonIcon}"/></DrawingImage.Drawing></DrawingImage>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,0,0,2"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#801B252B"/><Setter Property="Foreground" Value="#ECF5F4"/>
   <Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="4,0,4,8"/><Setter Property="FontFamily" Value="{DynamicResource MenuFont}"/><Setter Property="FontStyle" Value="Italic"/><Setter Property="FontSize" Value="19"/>
   <Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="#364E5659"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#B0354549"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E1CFA1"/><Setter TargetName="Chrome" Property="Background" Value="#B0354542"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#ECF5F4"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontSize" Value="19"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#B0354549"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#F3E7C3"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#ECF5F4"/><Setter Property="FontSize" Value="19"/><Setter Property="FontStyle" Value="Italic"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MaxDropDownHeight" Value="420"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" CornerRadius="5" Background="#801B252B" BorderBrush="#364E5659" BorderThickness="2" Padding="20,10"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 5,5 L 10,0" Stroke="#A5BAC5" StrokeThickness="2"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#B0354549"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,10"/>
    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#F01B252B" BorderBrush="#E1CFA1" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0">
      <ScrollViewer><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#293A42"/><Setter Property="Foreground" Value="#63E0BD"/><Setter Property="BorderThickness" Value="0"/></Style>
  <SolidColorBrush x:Key="P1MotionAccent" Color="#7EE9C9"/>
  <SolidColorBrush x:Key="P2MotionAccent" Color="#E5C384"/>
  <SolidColorBrush x:Key="MotionMuted" Color="#78939F"/>
  <DoubleCollection x:Key="MotionDash">2 3</DoubleCollection>
  <RectangleGeometry x:Key="MotionDeviceShape" Rect="0,0,34,24" RadiusX="5" RadiusY="5"/>
  <DrawingImage x:Key="MotionDeviceImage"><DrawingImage.Drawing><GeometryDrawing Brush="#0B141B" Geometry="{StaticResource MotionDeviceShape}"><GeometryDrawing.Pen><Pen Brush="{StaticResource MotionMuted}" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="P1MotionDeviceImage"><DrawingImage.Drawing><GeometryDrawing Brush="#0B141B" Geometry="{StaticResource MotionDeviceShape}"><GeometryDrawing.Pen><Pen Brush="{StaticResource P1MotionAccent}" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="P2MotionDeviceImage"><DrawingImage.Drawing><GeometryDrawing Brush="#0B141B" Geometry="{StaticResource MotionDeviceShape}"><GeometryDrawing.Pen><Pen Brush="{StaticResource P2MotionAccent}" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
 </Window.Resources> <Grid><Viewbox Stretch="Uniform" Margin="32,24"><Grid x:Name="Shell" Width="1280" Height="1100"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="14,4,14,10">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="CornerDot" Width="9" Height="9" Fill="#4B5A60" Margin="2,0,8,0"/><TextBlock x:Name="CornerServer" Text="Server stopped" Foreground="#A5BAC5" FontSize="13"/></StackPanel><TextBlock Grid.Column="1" Text="THE LEGEND OF ZELDA" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" Foreground="#CFBF9C" FontSize="13" VerticalAlignment="Center"/><Button x:Name="Help" Grid.Column="2" Content="Help" HorizontalAlignment="Right" Padding="16,8"/></Grid>
  <Border x:Name="HelpPanel" Visibility="Collapsed" CornerRadius="12" Padding="18" Background="#193039" Margin="0,8,0,16"><TextBlock Foreground="#C7DCDD" Text="SESSION: Start session opens the dedicated server, then Player 1 and Player 2 in their own Cemu windows. When each game reaches the main menu, press Continue in that window within about a minute.&#10;&#10;CONTROLLERS: choose a player, then press the bottom face button on a controller to assign it. Each Cemu window only sees its own controller. Vibration support depends on the controller.&#10;&#10;DISPLAY: the two Cemu windows share the primary display. Split chooses side by side or top and bottom; Auto splits wide displays side by side. Windows are placed when they open, so moving one by hand is kept.&#10;&#10;The preview shows the split layout, not a game screenshot. Use Alt+Tab to come back to this launcher while the game is open."/></Border>
  <TextBlock Text="BREATH OF THE WILD" TextAlignment="Center" FontFamily="{DynamicResource LogoFont}" FontStretch="Normal" FontSize="40" FontWeight="Normal" Foreground="#E2D5B2" Margin="0,6,0,3"/>
  <TextBlock Text="ONLINE MULTIPLAYER" TextAlignment="Center" Foreground="#A7B5B5" FontSize="13" Margin="1,0,0,24"/>
  <Grid x:Name="MainGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel x:Name="Players" Margin="0,0,20,0">
    <TextBlock Text="CONTROLLERS" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontWeight="Normal" FontSize="14" Foreground="#CBBF9F" Margin="0,0,0,12"/>
    <Border Background="#A0152027" CornerRadius="8" Padding="18" BorderBrush="#3449585A" BorderThickness="1" Margin="0,0,0,12">
     <StackPanel>
      <StackPanel><TextBlock Text="Player 1" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontSize="23"/><TextBlock x:Name="P1Status" TextAlignment="Center" Foreground="#63E0BD" FontSize="14" Margin="0,3,0,0"/></StackPanel>
      <TextBlock x:Name="P1Name" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#A5BAC5" Margin="0,4,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
       <Canvas Height="60" Width="175" HorizontalAlignment="Left"><Ellipse Width="58" Height="58" Canvas.Left="0" Canvas.Top="0" Fill="#0B141B" Stroke="#304752"/><Ellipse Width="58" Height="58" Canvas.Left="91" Canvas.Top="0" Fill="#0B141B" Stroke="#304752"/><Ellipse x:Name="P1L" Width="18" Height="18" Fill="#63E0BD" Canvas.Left="20" Canvas.Top="20"/><Ellipse x:Name="P1R" Width="18" Height="18" Fill="#E0BE75" Canvas.Left="111" Canvas.Top="20"/></Canvas>
       <StackPanel Grid.Column="1"><TextBlock Text="LT / RT" FontSize="12" Foreground="#78939F"/><ProgressBar x:Name="P1LT" Maximum="255" Margin="0,8,0,10"/><ProgressBar x:Name="P1RT" Maximum="255"/></StackPanel><Viewbox Grid.Column="2" Width="64" Height="60" HorizontalAlignment="Right" IsHitTestVisible="False"><Canvas x:Name="P1Motion" Width="64" Height="60" AutomationProperties.Name="Player 1 motion sensor"><Ellipse x:Name="P1MotionRing" Width="54" Height="54" Canvas.Left="5" Canvas.Top="3" Stroke="#304752" StrokeThickness="2"/><Image x:Name="P1MotionDevice" Width="34" Height="24" Canvas.Left="15" Canvas.Top="18" Source="{StaticResource MotionDeviceImage}" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Player 1 motion sensor" AutomationProperties.ItemStatus="Unavailable"><Image.RenderTransform><RotateTransform/></Image.RenderTransform></Image><Ellipse x:Name="P1MotionDot" Width="8" Height="8" Canvas.Left="28" Canvas.Top="26" Fill="#7EE9C9" Visibility="Collapsed"/><Path x:Name="P1MotionSlash" Data="M 16,44 L 48,16" Stroke="#78939F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
      </Grid>
      <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0"><Button x:Name="Assign1" Width="200" Content="Assign controller"/><Button x:Name="Rumble1" Width="200" Content="Test vibration"/></WrapPanel>
     </StackPanel>
    </Border>
    <Border Background="#A0152027" CornerRadius="8" Padding="18" BorderBrush="#3449585A" BorderThickness="1" Margin="0,0,0,12">
     <StackPanel>
      <StackPanel><TextBlock Text="Player 2" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontSize="23"/><TextBlock x:Name="P2Status" TextAlignment="Center" Foreground="#63E0BD" FontSize="14" Margin="0,3,0,0"/></StackPanel>
      <TextBlock x:Name="P2Name" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#A5BAC5" Margin="0,4,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
       <Canvas Height="60" Width="175" HorizontalAlignment="Left"><Ellipse Width="58" Height="58" Canvas.Left="0" Canvas.Top="0" Fill="#0B141B" Stroke="#304752"/><Ellipse Width="58" Height="58" Canvas.Left="91" Canvas.Top="0" Fill="#0B141B" Stroke="#304752"/><Ellipse x:Name="P2L" Width="18" Height="18" Fill="#63E0BD" Canvas.Left="20" Canvas.Top="20"/><Ellipse x:Name="P2R" Width="18" Height="18" Fill="#E0BE75" Canvas.Left="111" Canvas.Top="20"/></Canvas>
       <StackPanel Grid.Column="1"><TextBlock Text="LT / RT" FontSize="12" Foreground="#78939F"/><ProgressBar x:Name="P2LT" Maximum="255" Margin="0,8,0,10"/><ProgressBar x:Name="P2RT" Maximum="255"/></StackPanel><Viewbox Grid.Column="2" Width="64" Height="60" HorizontalAlignment="Right" IsHitTestVisible="False"><Canvas x:Name="P2Motion" Width="64" Height="60" AutomationProperties.Name="Player 2 motion sensor"><Ellipse x:Name="P2MotionRing" Width="54" Height="54" Canvas.Left="5" Canvas.Top="3" Stroke="#304752" StrokeThickness="2"/><Image x:Name="P2MotionDevice" Width="34" Height="24" Canvas.Left="15" Canvas.Top="18" Source="{StaticResource MotionDeviceImage}" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Player 2 motion sensor" AutomationProperties.ItemStatus="Unavailable"><Image.RenderTransform><RotateTransform/></Image.RenderTransform></Image><Ellipse x:Name="P2MotionDot" Width="8" Height="8" Canvas.Left="28" Canvas.Top="26" Fill="#E5C384" Visibility="Collapsed"/><Path x:Name="P2MotionSlash" Data="M 16,44 L 48,16" Stroke="#78939F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
      </Grid>
      <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0"><Button x:Name="Assign2" Width="200" Content="Assign controller"/><Button x:Name="Rumble2" Width="200" Content="Test vibration"/></WrapPanel>
     </StackPanel>
    </Border>
    <Button x:Name="Swap" Content="⇄  Swap players" HorizontalAlignment="Center" MinWidth="300"/>
   </StackPanel>
   <StackPanel x:Name="DisplayPanel" Grid.Column="1">
    <TextBlock Text="DISPLAY" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontWeight="Normal" FontSize="14" Foreground="#CBBF9F" Margin="0,0,0,12"/>
    <Border Background="#A0152027" CornerRadius="8" Padding="18" BorderBrush="#3449585A" BorderThickness="1" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock x:Name="ScreenInfo" TextAlignment="Center" FontSize="23" FontWeight="Normal"/>
      <TextBlock Text="Primary display · automatic detection" TextAlignment="Center" Foreground="#9EB2BD" FontSize="14" Margin="0,4,0,15"/>
      <Border Background="#080E13" x:Name="PreviewFrame" CornerRadius="6" Padding="6" Height="192" Width="360" HorizontalAlignment="Center"><Grid x:Name="Preview">
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border x:Name="View1" Background="#A629554C" CornerRadius="3" Margin="3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="P1PreviewLabel" Text="P1" FontSize="24" FontWeight="Bold" Foreground="#7EE9C9" VerticalAlignment="Center"/><Image Source="{StaticResource P1Person}" Width="30" Height="30" Margin="6,0"/></StackPanel></Viewbox></Border>
       <Border x:Name="View2" Background="#A6504631" CornerRadius="3" Margin="3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="P2PreviewLabel" Text="P2" FontSize="24" FontWeight="Bold" Foreground="#E5C384" VerticalAlignment="Center"/><Image Source="{StaticResource P2Person}" Width="30" Height="30" Margin="6,0"/></StackPanel></Viewbox></Border>
      </Grid></Border>
      <TextBlock x:Name="LayoutInfo" TextAlignment="Center" Foreground="#A5BAC5" Margin="0,12,0,14"/>
      <Button x:Name="Layout" HorizontalAlignment="Center" Width="380" Content="Split: automatic" Margin="0,0,0,10"/>
      <ComboBox x:Name="FpsBox" HorizontalAlignment="Center" Width="380" Margin="0,0,0,10"/>
     </StackPanel>
    </Border>
    <TextBlock Text="GRAPHICS" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontWeight="Normal" FontSize="14" Foreground="#CBBF9F" Margin="0,8,0,12"/>
    <Border Background="#A0152027" CornerRadius="8" Padding="18" BorderBrush="#3449585A" BorderThickness="1" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock x:Name="GraphicsNote" TextAlignment="Center" Foreground="#9EB2BD" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" Text="Applied to both games the next time a session starts."/>
      <TextBlock Text="Render resolution" FontSize="12" Foreground="#78939F" HorizontalAlignment="Center" Width="380"/>
      <ComboBox x:Name="ScaleBox" HorizontalAlignment="Center" Width="380" Margin="0,4,0,10"/>
      <TextBlock Text="Shadows" FontSize="12" Foreground="#78939F" HorizontalAlignment="Center" Width="380"/>
      <ComboBox x:Name="ShadowsBox" HorizontalAlignment="Center" Width="380" Margin="0,4,0,10"/>
      <TextBlock Text="Shadow draw distance" FontSize="12" Foreground="#78939F" HorizontalAlignment="Center" Width="380"/>
      <ComboBox x:Name="ShadowDistanceBox" HorizontalAlignment="Center" Width="380" Margin="0,4,0,10"/>
      <TextBlock Text="Anti-aliasing" FontSize="12" Foreground="#78939F" HorizontalAlignment="Center" Width="380"/>
      <ComboBox x:Name="AntiAliasingBox" HorizontalAlignment="Center" Width="380" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="SESSION" TextAlignment="Center" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontWeight="Normal" FontSize="14" Foreground="#CBBF9F" Margin="0,8,0,12"/>
    <Border Background="#A0152027" CornerRadius="8" Padding="18" BorderBrush="#3449585A" BorderThickness="1">
     <StackPanel>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Ellipse x:Name="ServerDot" Grid.Row="0" Width="12" Height="12" Fill="#4B5A60" VerticalAlignment="Center"/>
       <TextBlock Grid.Row="0" Grid.Column="1" Text="Dedicated server"/><TextBlock x:Name="ServerText" Grid.Row="0" Grid.Column="2" Foreground="#A5BAC5" Text="Stopped"/>
       <Ellipse x:Name="ADot" Grid.Row="1" Width="12" Height="12" Fill="#4B5A60" VerticalAlignment="Center"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Text="Player 1 (Cemu A)"/><TextBlock x:Name="AText" Grid.Row="1" Grid.Column="2" Foreground="#A5BAC5" Text="Stopped"/>
       <Ellipse x:Name="BDot" Grid.Row="2" Width="12" Height="12" Fill="#4B5A60" VerticalAlignment="Center"/>
       <TextBlock Grid.Row="2" Grid.Column="1" Text="Player 2 (Cemu B)"/><TextBlock x:Name="BText" Grid.Row="2" Grid.Column="2" Foreground="#A5BAC5" Text="Stopped"/>
      </Grid>
      <TextBlock x:Name="Prompt" TextAlignment="Center" Foreground="#E0BE75" MinHeight="44" FontSize="15" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>
  <Border x:Name="DetailsPanel" Visibility="Collapsed" Background="#E0152027" CornerRadius="8" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Session log" TextAlignment="Center" Foreground="#CBBF9F" FontSize="14" Margin="0,0,0,8"/><TextBox x:Name="Log" IsReadOnly="True" Height="220" FontFamily="Consolas" FontStretch="Normal" FontSize="13" Background="#0F171C" Foreground="#A5BAC5" BorderBrush="#3449585A" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><TextBlock Text="Server console" TextAlignment="Center" Foreground="#CBBF9F" FontSize="14" Margin="0,14,0,8"/><TextBox x:Name="ServerLog" IsReadOnly="True" Height="160" FontFamily="Consolas" FontStretch="Normal" FontSize="13" Background="#0F171C" Foreground="#A5BAC5" BorderBrush="#3449585A" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><TextBox x:Name="ServerCommand" ToolTip="Server command, then Enter (type help)" Margin="0,8,0,0" FontFamily="Consolas" FontStretch="Normal" FontSize="13" Background="#0F171C" Foreground="#E2D5B2" BorderBrush="#3449585A" Padding="6,4"/></StackPanel></Border>
 </StackPanel>
 </ScrollViewer>
 <StackPanel Grid.Row="1" Margin="14,0,14,8">
  <Border Background="#80212E2D" CornerRadius="5" Padding="14" Margin="0,8,0,12"><TextBlock x:Name="Status" TextAlignment="Center" Text="Ready." Foreground="#AEE2D2"/></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="Details" Content="Details" MinWidth="150" Padding="20,16"/><Button x:Name="Start" Content="START SESSION" MinWidth="300" FontFamily="{DynamicResource TitleFont}" FontStretch="Normal" FontStyle="Normal" Background="#B03C554B" BorderBrush="#D5C396" FontSize="20" Padding="40,15"/><Button x:Name="Stop" Content="Stop session" MinWidth="180" Padding="20,16"/><Button x:Name="Exit" Content="Exit" MinWidth="150" Padding="20,16"/></StackPanel>
 </StackPanel>
 </Grid></Viewbox></Grid>
</Window>
