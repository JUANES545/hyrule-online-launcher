  <TextBlock Text="BREATH OF THE WILD" TextAlignment="Center" FontFamily="{DynamicResource LogoFont}" FontStretch="Normal" FontSize="34" FontWeight="Normal" Foreground="#E2D5B2" Margin="0,2,0,2"/>
