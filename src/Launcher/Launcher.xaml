  <DrawingImage x:Key="P2Person"><DrawingImage.Drawing><GeometryDrawing Brush="#E5C384" Geometry="{StaticResource PersonIcon}"/></DrawingImage.Drawing></DrawingImage>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,0,0,2"/></Style>
